{
  "version": "{APP_VERSION}",
  "description": "{APP_DISPLAY_NAME}",
  "homepage": "https://github.com/zecarneiro/favorite-apps-tray",
  "url": "https://github.com/zecarneiro/favorite-apps-tray/releases/download/v{APP_VERSION}/favorite-apps-tray-{APP_VERSION}.zip",
  "bin": "{APP_NAME}.exe",
  "post_install": [
    "$WScriptShell = New-Object -ComObject WScript.Shell",
    "$Shortcut = $WScriptShell.CreateShortcut(\"$([Environment]::GetFolderPath('Programs'))\\{APP_DISPLAY_NAME}.lnk\")",
    "$Shortcut.TargetPath = \"$dir\\{APP_NAME}.exe\"",
    "$Shortcut.IconLocation = \"$dir\\win.ico, 0\"",
    "$Shortcut.Save()"
  ],
  "pre_uninstall": [
    "Remove-Item -Path \"$([Environment]::GetFolderPath('Programs'))\\{APP_DISPLAY_NAME}.lnk\" -Force"
  ],
  "persist": ".data",
  "checkver": "github",
  "autoupdate": {
    "url": "https://github.com/zecarneiro/favorite-apps-tray/releases/download/v$version/favorite-apps-tray-{APP_VERSION}.zip"
  }
}
